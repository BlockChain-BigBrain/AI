# FastAPI와 Node 백엔드가 공유하는 내부 인증 키입니다.
# 실제 값은 충분히 긴 무작위 문자열로 바꾸고 .env 파일에 저장하세요.
TRACK_AI_API_KEY=replace-with-a-long-random-secret
TRACK_AI_URL=http://127.0.0.1:8000
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
POLYGON_NETWORK=amoy
# 배포할 때만 설정합니다. 현재 코드는 이 주소를 payload에 포함하고,
# 실제 지갑 서명·트랜잭션 전송은 프론트/블록체인 서비스가 담당합니다.
TRACK_REGISTRY_CONTRACT=
