{
  "version": "ai-party-v1",
  "ai": {
    "submit": "POST /verify",
    "poll": "GET /verify/{jobId}",
    "header": "X-Internal-API-Key",
    "states": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"],
    "decisions": ["PASS", "WARN", "HOLD", "BLOCK"]
  },
  "persistence": {
    "requiredEvidence": [
      "audioHash",
      "manifestHash",
      "modelVersion",
      "corpusVersion",
      "scoreVersion",
      "decisionPolicyVersion",
      "thresholds",
      "similarTracks",
      "duplicate",
      "provisional"
    ],
    "storage": "Detailed AI manifest is stored in IPFS/MySQL; it is not part of the current TrackRegistry ABI."
  },
  "blockchain": {
    "repository": "https://github.com/BlockChain-BigBrain/Contract",
    "contractVersion": "main / TrackRegistry + LicenseMarketplace + LicenseNFT + RevenueSplitter",
    "registrationCall": "TrackRegistry.registerTrack",
    "purchaseCall": "LicenseMarketplace.purchaseLicense",
    "eip712Domain": {
      "name": "TrackAI_Registry",
      "version": "1"
    },
    "signatureFields": [
      "audioHash",
      "metadataCIDHash",
      "registrant",
      "contributorsHash",
      "similarityScore",
      "modelVersion",
      "nonce",
      "deadline"
    ],
    "registrationPayloadFields": [
      "audioHash",
      "metadataCID",
      "contributors",
      "shares",
      "similarityScore",
      "modelVersion",
      "nonce",
      "deadline"
    ],
    "derivedOnchainFields": {
      "trackId": "TrackRegistered event / Registry counter",
      "isHold": "getVerification(trackId).status == HOLD",
      "licensable": "isTrackLicensable(trackId); false for HOLD",
      "manifestHash": "off-chain IPFS/MySQL evidence only in current contract"
    },
    "signaturePolicy": {
      "PASS": {
        "issueRegistrationSignature": true,
        "allowRegisterTrack": true,
        "allowPurchase": true,
        "onchainStatus": "PASS"
      },
      "WARN": {
        "issueRegistrationSignature": true,
        "allowRegisterTrack": true,
        "allowPurchase": true,
        "onchainStatus": "WARN"
      },
      "HOLD": {
        "issueRegistrationSignature": true,
        "allowRegisterTrack": true,
        "allowPurchase": false,
        "onchainStatus": "HOLD"
      },
      "BLOCK": {
        "issueRegistrationSignature": false,
        "allowRegisterTrack": false,
        "allowPurchase": false,
        "onchainStatus": null
      }
    },
    "automaticActions": ["BLOCK registration and minting"],
    "note": "AI evidence is not a legal ownership decision; HOLD is recorded by VerificationStatus and purchase is blocked. Adding explicit manifestHash/isHold fields requires a new contract version and deployment."
  }
}
